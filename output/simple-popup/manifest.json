{
  "manifest_version": 3,
  "name": "Simple Popup",
  "version": "1.0.0",
  "description": "A simple popup extension for testing",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "@chrome2fox-a2e76e35c45c759d",
      "strict_min_version": "109.0"
    }
  }
}