{
  "manifest_version": 3,
  "name": "Content Script Extension",
  "version": "1.0.0",
  "description": "Extension with content scripts",
  "permissions": ["storage", "activeTab"],
  "content_scripts": [
    {
      "matches": ["*://*.example.com/*"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
